QMainWindow {
    background-color: #0b0f14;
}

QWidget {
    color: #d9f6ff;
    font-family: "Segoe UI";
    font-size: 14px;
}

QLabel#status {
    font-size: 18px;
    font-weight: bold;
    padding: 10px;
}

QTextEdit#conversation {
    background-color: #111820;
    border: 1px solid #263542;
    border-radius: 10px;
    padding: 15px;
    font-size: 15px;
}

QPushButton#microphone {
    background-color: #16232d;
    border: 1px solid #3b6575;
    border-radius: 10px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#microphone:hover {
    background-color: #1c303c;
}

QPushButton#microphone:pressed {
    background-color: #243f4d;
}